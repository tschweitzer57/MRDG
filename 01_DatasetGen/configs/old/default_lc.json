        "loop_noise_sigmas": [0.175, 0.175, 0.175, 0.05, 0.05, 0.05],
        "range_detect_noise_sigmas": [0.175, 0.175, 0.175, 0.05, 0.05, 0.05],
        "pose_detect_noise_sigmas": [0.175, 0.175, 0.175, 0.05, 0.05, 0.05]
