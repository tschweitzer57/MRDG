{
	"name": "error-metrics-v3",
	"image": "tschweitzer57/gtsam:4.3a0-ros2jazzy-mirage",

	"workspaceFolder": "/home/workspace",
	"mounts": [
		"source=${localWorkspaceFolder}/3_Metrics/scripts,target=/home/workspace/scripts,type=bind",
		"source=${localWorkspaceFolder}/3_Metrics/helpers,target=/home/workspace/helpers,type=bind",
		"source=${localWorkspaceFolder}/4_Datasets,target=/home/workspace/datasets,type=bind", // mandatory to get groundtruths
		"source=${localWorkspaceFolder}/5_Results/Computed,target=/home/workspace/input,type=bind",
		"source=${localWorkspaceFolder}/5_Results/Metrics,target=/home/workspace/saved_output,type=bind",
		"source=${localWorkspaceFolder}/5_Results/Display,target=/home/workspace/display_output,type=bind"
	],
	
	"containerEnv": {
    	"PYTHONPATH": "/home/workspace/helpers:/home/workspace/scripts:$PYTHONPATH"
	},

	"postCreateCommand": "pip install evo"
}