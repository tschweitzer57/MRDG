// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "dataset-gen",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	//	"image": "tschweitzer57/gtsam:ros2-humble", TODO: debuggen folgende Anweisung: odom_noise_model = gtsam.noiseModel.Diagonal.Sigmas([0.175, 0.175, 0.175, 0.05, 0.05, 0.05])
	"image": "tschweitzer57/gtsam:base-20.04",

	// Setup the workspace and mount on docker:
	"workspaceFolder": "/home/workspace",
	"mounts": [
		"source=${localWorkspaceFolder}/1_Generator/helpers,target=/home/workspace/helpers,type=bind",
		"source=${localWorkspaceFolder}/1_Generator/scripts,target=/home/workspace/scripts,type=bind",
		"source=${localWorkspaceFolder}/1_Generator/output,target=/home/workspace/output,type=bind",
		"source=${localWorkspaceFolder}/2_Configurations,target=/home/workspace/configs,type=bind",
		"source=${localWorkspaceFolder}/4_Datasets,target=/home/workspace/saved_outputs,type=bind"
	],
	"containerEnv": {
    	"PYTHONPATH": "/home/workspace/helpers:/home/workspace/scripts:$PYTHONPATH"
	}
}